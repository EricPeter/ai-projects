{
  "title": "AI Proxy — Production Dashboard",
  "uid": "ai-proxy-main",
  "schemaVersion": 36,
  "refresh": "10s",
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Request Rate (req/min)",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "rate(ai_requests_total[1m]) * 60", "legendFormat": "req/min"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"}
    },
    {
      "id": 2, "type": "stat", "title": "Total Cost (USD)",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "sum(ai_cost_dollars_total)", "legendFormat": "Total $"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 3, "type": "stat", "title": "Error Rate",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "rate(ai_errors_total[5m])", "legendFormat": "errors/s"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"}
    },
    {
      "id": 4, "type": "stat", "title": "P95 Latency (s)",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "targets": [{"expr": "histogram_quantile(0.95, rate(ai_latency_seconds_bucket[5m]))", "legendFormat": "p95"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 5, "type": "graph", "title": "Latency Percentiles",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"expr": "histogram_quantile(0.50, rate(ai_latency_seconds_bucket[5m]))", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, rate(ai_latency_seconds_bucket[5m]))", "legendFormat": "p95"},
        {"expr": "histogram_quantile(0.99, rate(ai_latency_seconds_bucket[5m]))", "legendFormat": "p99"}
      ]
    },
    {
      "id": 6, "type": "graph", "title": "Cost per Hour by Model",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [{"expr": "rate(ai_cost_dollars_total[1h]) * 3600", "legendFormat": "{{model}}"}]
    }
  ]
}
