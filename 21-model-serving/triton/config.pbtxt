name: "distilbert"
backend: "onnxruntime"
max_batch_size: 32

dynamic_batching {
  preferred_batch_size: [1, 8, 16, 32]
  max_queue_delay_microseconds: 100
}

input [
  { name: "input_ids"      data_type: TYPE_INT64 dims: [-1, 128] },
  { name: "attention_mask" data_type: TYPE_INT64 dims: [-1, 128] }
]

output [
  { name: "logits" data_type: TYPE_FP32 dims: [-1, 2] }
]

instance_group [
  { kind: KIND_GPU count: 1 },
  { kind: KIND_CPU count: 2 }
]
