# HuggingFace token — needed to download Canary-1B checkpoint
HF_TOKEN=hf_...

# NeMo model checkpoint (leave default to download from NGC)
CANARY_MODEL=nvidia/canary-1b-flash
SALM_MODEL=nvidia/salm

# Translation target language (ISO 639-1 code)
TARGET_LANG=en

# Server
HOST=0.0.0.0
PORT=8024

# Word boosting
WORD_BOOST_FACTOR=15.0

# Beam search
BEAM_SIZE=8

# ── Live streaming ────────────────────────────────────────────────────────────
# Cache-aware streaming ASR (WebSocket /ws/transcribe).
# parakeet_realtime_eou_120m-v1 emits inline <EOU>/<EOB> turn tokens.
STREAMING_ASR_MODEL=nvidia/parakeet_realtime_eou_120m-v1
# Point at a local Luganda fine-tune (.nemo) once trained:
# STREAMING_ASR_CHECKPOINT=outputs/streaming_luganda/streaming_luganda.nemo
DECODER_TYPE=rnnt

# End-of-turn detection
TURN_STOP_SECS=0.8
TURN_MIN_WORDS=1
TURN_MAX_BUFFER_WORDS=60
USE_EOU_TOKENS=true

# Sortformer streaming diarizer
DIAR_STREAMING_MODEL=nvidia/diar_streaming_sortformer_4spk-v2
DIAR_CHUNK_SECS=1.0
